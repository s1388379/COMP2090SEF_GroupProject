class MaxHeap:
    """
    A simple max-heap implemented from scratch using a Python list.
    """

    def __init__(self):
        # Underlying array to store heap elements
        self.data = []

    # ---------- index helper methods ----------

    def _parent_index(self, i):
        """Return the index of the parent of node i."""
        return (i - 1) // 2

    def _left_child_index(self, i):
        """Return the index of the left child of node i."""
        return 2 * i + 1

    def _right_child_index(self, i):
        """Return the index of the right child of node i."""
        return 2 * i + 2

