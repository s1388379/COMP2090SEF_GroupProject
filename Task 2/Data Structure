    def peek_max(self):
        """
        Return the maximum value without removing it.
        Return None if heap is empty.
        """
        if not self.data:
            return None
        return self.data[0]

    # ---------- utility methods ----------

    def __len__(self):
        """Return number of elements in the heap."""
        return len(self.data)

    def is_empty(self):
        """Return True if heap has no elements."""
        return len(self.data) == 0


